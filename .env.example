# KeyShield environment. Copy to .env for local dev; docker-compose injects its own.
# Defaults in lib/env.ts already match docker-compose, so most of these are optional locally.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Data stores ---
# In docker-compose the host is "postgres" / "redis"; locally it is localhost.
DATABASE_URL=postgres://keyshield:keyshield@localhost:5432/keyshield
REDIS_URL=redis://localhost:6379

# --- Sessions (REQUIRED in production) ---
# Generate: `openssl rand -base64 48`  — must be >= 32 chars.
SESSION_SECRET=dev-only-insecure-session-secret-change-me-32b
SESSION_COOKIE_NAME=keyshield_session
SESSION_IDLE_TIMEOUT_MIN=30
SESSION_ABSOLUTE_TIMEOUT_MIN=720

# Public origin — used for CORS allowlist, CSRF origin checks, and WebAuthn.
APP_ORIGIN=http://localhost:3000

# Number of trusted reverse proxies in front of the app. The real client IP is
# read from X-Forwarded-For counting this many hops from the right, so a spoofed
# left-most XFF value can't forge rate-limit keys or audit IPs. Set to the number
# of proxies you actually run (nginx/ingress/CDN); use 0 if directly exposed.
TRUSTED_PROXY_COUNT=1

# --- WebAuthn / passkeys ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=KeyShield
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Breach detection (HIBP Pwned Passwords k-anonymity) ---
HIBP_API_BASE=https://api.pwnedpasswords.com
HIBP_ADD_PADDING=true
HIBP_TIMEOUT_MS=3500
# online = live HIBP range API; offline = local downloaded corpus (enterprise mode).
BREACH_MODE=online
BREACH_CORPUS_PATH=lib/breach/offline-corpus.txt
BREACH_CACHE_TTL_SEC=300

# Set true only for automated tests.
RATE_LIMIT_DISABLED=false

# --- Demo admin seed (used by `npm run db:seed`) ---
# Login with ADMIN_EMAIL + ADMIN_PASSWORD, then the TOTP code from ADMIN_TOTP_SECRET.
ADMIN_EMAIL=admin@keyshield.local
ADMIN_PASSWORD=correct-horse-battery-staple-42
# Base32 TOTP secret. Add it to any authenticator app (or compute codes with otplib).
ADMIN_TOTP_SECRET=KS5DEMOADMINSEEDTOTPBASE32SECRET

# --- Optional observability (no-op unless set) ---
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
